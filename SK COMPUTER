<!DOCTYPE html>
<html lang="mr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SK Computer - ग्राहक पोर्टल</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #f0f2f5;
      margin: 0;
      padding: 20px;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 90vh;
    }
    .card {
      background: #ffffff;
      padding: 25px 30px;
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      width: 100%;
      max-width: 420px;
    }
    h2 {
      margin-top: 0;
      color: #1a73e8;
      text-align: center;
    }
    .form-group {
      margin-bottom: 15px;
    }
    label {
      display: block;
      margin-bottom: 5px;
      font-weight: 600;
      font-size: 14px;
      color: #333;
    }
    input, textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
      box-sizing: border-box;
      font-size: 14px;
    }
    button {
      width: 100%;
      padding: 11px;
      background: #1a73e8;
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 8px;
    }
    button:hover {
      background: #1557b0;
    }
    .btn-logout {
      background: #dc3545;
      margin-top: 15px;
    }
    .btn-logout:hover {
      background: #bd2130;
    }
    .toggle-link {
      text-align: center;
      margin-top: 15px;
      font-size: 14px;
    }
    .toggle-link a {
      color: #1a73e8;
      text-decoration: none;
      font-weight: bold;
    }
    #dashboard-section {
      display: none;
    }
    .msg {
      font-size: 13px;
      text-align: center;
      margin-top: 10px;
    }
  </style>

  <!-- Firebase Scripts (Compat Libraries) -->
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>
</head>
<body>

  <div class="card">
    <!-- १. लॉगिन आणि रजिस्ट्रेशन फॉर्म -->
    <div id="auth-section">
      <h2 id="auth-title">SK Computer लॉगिन</h2>
      
      <div class="form-group">
        <label>ईमेल पत्ता:</label>
        <input type="email" id="auth-email" placeholder="example@gmail.com" required>
      </div>
      
      <div class="form-group">
        <label>पासवर्ड:</label>
        <input type="password" id="auth-password" placeholder="किमान ६ अक्षरे" required>
      </div>

      <button id="btn-login" onclick="login()">लॉगिन करा</button>
      <button id="btn-register" onclick="register()" style="display:none; background:#28a745;">नवीन खाते तयार करा</button>

      <div class="toggle-link">
        <span id="toggle-text">खाते नाही का?</span> 
        <a href="javascript:void(0)" onclick="toggleAuthMode()" id="toggle-btn">येथे नोंदणी करा</a>
      </div>
      <p id="auth-msg" class="msg"></p>
    </div>

    <!-- २. ग्राहक डॅशबोर्ड व माहिती अपडेट फॉर्म -->
    <div id="dashboard-section">
      <h2>ग्राहक माहिती अपडेट</h2>
      <p style="text-align:center; font-size:13px; color:#666;">लॉगिन ईमेल: <b id="user-email-display"></b></p>

      <div class="form-group">
        <label>पूर्ण नाव:</label>
        <input type="text" id="cust-name" placeholder="तुमचे पूर्ण नाव">
      </div>

      <div class="form-group">
        <label>मोबाईल नंबर:</label>
        <input type="tel" id="cust-phone" placeholder="१० अंकी मोबाईल नंबर">
      </div>

      <div class="form-group">
        <label>पत्ता / गाव:</label>
        <textarea id="cust-address" rows="2" placeholder="पत्ता किंवा गाव"></textarea>
      </div>

      <div class="form-group">
        <label>कामाचे तपशील / इतर माहिती:</label>
        <textarea id="cust-details" rows="2" placeholder="उदा. पॅन कार्ड, ऑनलाईन फॉर्म, प्रिंटिंग काम"></textarea>
      </div>

      <button onclick="updateUserData()" style="background:#28a745;">माहिती अपडेट (Save) करा</button>
      <button onclick="logout()" class="btn-logout">लॉग आऊट</button>
      <p id="db-msg" class="msg"></p>
    </div>
  </div>

  <script>
    // तुमचे Firebase Configuration
    const firebaseConfig = {
      apiKey: "AIzaSyCguRWlUD0XhbTT-t90qxmhVMKRe-j09b8",
      authDomain: "sk-computer-53668.firebaseapp.com",
      projectId: "sk-computer-53668",
      storageBucket: "sk-computer-53668.firebasestorage.app",
      messagingSenderId: "181873271339",
      appId: "1:181873271339:web:b22202fac5706669e8406e",
      measurementId: "G-SH186W2EVD"
    };

    // Firebase चालू करा
    firebase.initializeApp(firebaseConfig);
    const auth = firebase.auth();
    const db = firebase.firestore();

    let isRegisterMode = false;

    // लॉगिन आणि रजिस्टर बदलण्यासाठी
    function toggleAuthMode() {
      isRegisterMode = !isRegisterMode;
      document.getElementById('auth-title').innerText = isRegisterMode ? "नवीन खाते नोंदणी" : "SK Computer लॉगिन";
      document.getElementById('btn-login').style.display = isRegisterMode ? "none" : "block";
      document.getElementById('btn-register').style.display = isRegisterMode ? "block" : "none";
      document.getElementById('toggle-text').innerText = isRegisterMode ? "आधीच खाते आहे का?" : "खाते नाही का?";
      document.getElementById('toggle-btn').innerText = isRegisterMode ? "लॉगिन करा" : "येथे नोंदणी करा";
      document.getElementById('auth-msg').innerText = "";
    }

    // १. नवीन ग्राहक नोंदणी (Registration)
    function register() {
      const email = document.getElementById('auth-email').value;
      const pass = document.getElementById('auth-password').value;
      const msg = document.getElementById('auth-msg');

      if (!email || !pass) {
        msg.style.color = "red";
        msg.innerText = "कृपया ईमेल आणि पासवर्ड टाका.";
        return;
      }

      auth.createUserWithEmailAndPassword(email, pass)
        .then((userCredential) => {
          msg.style.color = "green";
          msg.innerText = "खाते यशस्वीरीत्या तयार झाले!";
        })
        .catch((error) => {
          msg.style.color = "red";
          msg.innerText = "त्रुटी: " + error.message;
        });
    }

    // २. लॉगिन (Login)
    function login() {
      const email = document.getElementById('auth-email').value;
      const pass = document.getElementById('auth-password').value;
      const msg = document.getElementById('auth-msg');

      if (!email || !pass) {
        msg.style.color = "red";
        msg.innerText = "कृपया ईमेल आणि पासवर्ड टाका.";
        return;
      }

      auth.signInWithEmailAndPassword(email, pass)
        .catch((error) => {
          msg.style.color = "red";
          msg.innerText = "त्रुटी: " + error.message;
        });
    }

    // ३. लॉग आऊट (Logout)
    function logout() {
      auth.signOut();
    }

    // ४. युझर लॉगिन स्टेट तपासणे आणि डेटा लोड करणे
    auth.onAuthStateChanged((user) => {
      const authSection = document.getElementById('auth-section');
      const dashSection = document.getElementById('dashboard-section');

      if (user) {
        authSection.style.display = "none";
        dashSection.style.display = "block";
        document.getElementById('user-email-display').innerText = user.email;

        // डेटाबेसवरून आधीची माहिती आणणे
        db.collection("customers").doc(user.uid).get().then((doc) => {
          if (doc.exists) {
            const data = doc.data();
            document.getElementById('cust-name').value = data.name || "";
            document.getElementById('cust-phone').value = data.phone || "";
            document.getElementById('cust-address').value = data.address || "";
            document.getElementById('cust-details').value = data.details || "";
          }
        });
      } else {
        authSection.style.display = "block";
        dashSection.style.display = "none";
      }
    });

    // ५. माहिती सेव्ह किंवा अपडेट करणे (Firestore Database Update)
    function updateUserData() {
      const user = auth.currentUser;
      const msg = document.getElementById('db-msg');
      if (!user) return;

      const customerData = {
        name: document.getElementById('cust-name').value,
        phone: document.getElementById('cust-phone').value,
        address: document.getElementById('cust-address').value,
        details: document.getElementById('cust-details').value,
        email: user.email,
        updatedAt: new Date().toLocaleString('mr-IN')
      };

      db.collection("customers").doc(user.uid).set(customerData, { merge: true })
        .then(() => {
          msg.style.color = "green";
          msg.innerText = "माहिती यशस्वीरीत्या अपडेट झाली!";
          setTimeout(() => { msg.innerText = ""; }, 4000);
        })
        .catch((error) => {
          msg.style.color = "red";
          msg.innerText = "अपडेट करताना त्रुटी आली: " + error.message;
        });
    }
  </script>
</body>
</html>
