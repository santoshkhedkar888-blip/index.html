rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validAmounts(data) {
      return data.totalAmount is number && data.paidAmount is number &&
        data.totalAmount >= 0 && data.paidAmount >= 0 &&
        data.paidAmount <= data.totalAmount;
    }

    function validDocUrl(url) {
      return url == '' ||
        (url is string && url.matches('https://firebasestorage.googleapis.com/.*'));
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /customers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'address', 'email', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email;
      allow delete: if isAdmin();
    }

    match /jobs/{id} {
      // A phone-authenticated customer can read only jobs for their verified +91 number.
      // Email customers can read jobs they own; admins can read all jobs.
      allow get, list: if isAdmin() || (signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (request.auth.token.phone_number != null &&
          request.auth.token.phone_number == '+91' + resource.data.custPhone)
      ));

      allow create: if isAdmin()
        && validAmounts(request.resource.data)
        && validDocUrl(request.resource.data.documentUrl);

      // Preserve the email customer self-service flow for zero-fee pending requests.
      allow create: if verified()
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'custName', 'custPhone', 'custEmail', 'service', 'details',
          'documentUrl', 'status', 'totalAmount', 'paidAmount', 'paymentStatus',
          'payments', 'adminNotes', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.totalAmount == 0
        && request.resource.data.paidAmount == 0
        && request.resource.data.paymentStatus == 'Unpaid'
        && request.resource.data.payments.size() == 0
        && request.resource.data.adminNotes == ''
        && validDocUrl(request.resource.data.documentUrl);

      // Validate every saved amount in the database, not only in the browser UI.
      allow update: if isAdmin() && validAmounts(request.resource.data)
        && validDocUrl(request.resource.data.documentUrl);
      allow delete: if isAdmin();
    }

    match /publicJobs/{trackId} {
      // Public tracking intentionally returns only non-identifying job details.
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'jobNumber', 'title', 'status', 'totalAmount', 'paidAmount',
          'balance', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.totalAmount is number
        && request.resource.data.paidAmount is number
        && request.resource.data.balance is number
        && request.resource.data.totalAmount >= 0
        && request.resource.data.paidAmount >= 0
        && request.resource.data.paidAmount <= request.resource.data.totalAmount
        && request.resource.data.balance ==
          request.resource.data.totalAmount - request.resource.data.paidAmount;
      allow delete: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }
  }
}
